+    pub(super) fn alloy_diagnostic_state(
+        &self,
+        stream: &store::Ptr,
+    ) -> crate::alloy_diagnostics::QueueState {
+        let staged = match self.in_flight_data_frame {
+            InFlightData::Nothing => 0,
+            InFlightData::DataFrame(key) if key == stream.key() => 1,
+            InFlightData::DataFrame(_) => 2,
+            InFlightData::Drop => 3,
+        };
+        crate::alloy_diagnostics::QueueState {
+            empty: stream.pending_send.is_empty(),
+            buffered: stream.buffered_send_data,
+            requested: stream.requested_send_capacity,
+            stream_capacity: stream.send_flow.available().as_size(),
+            connection_capacity: self.flow.available().as_size(),
+            staged,
+        }
+    }
+
