+//! Numerical observer for the isolated Alloy diagnostic fork only.
+
+use std::cell::RefCell;
+use std::sync::Arc;
+use std::task::Poll;
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct QueueState {
+    pub empty: bool,
+    pub buffered: usize,
+    pub requested: u32,
+    pub stream_capacity: u32,
+    pub connection_capacity: u32,
+    // 0=none, 1=this stream, 2=other stream, 3=invalidated (Drop).
+    pub staged: u8,
+}
+
+#[derive(Clone, Copy, Debug)]
+pub enum Event {
+    Headers(u32),
+    Cancel(u32),
+    Data {
+        stream: u32,
+        bytes: u64,
+    },
+    Assignment {
+        origin: Origin,
+        runtime_before: bool,
+        runtime_after: bool,
+    },
+    DropEntry(Option<bool>),
+    Terminal {
+        class: u8,
+        initiator: u8,
+        code: u32,
+    },
+    Applied {
+        stream: u32,
+        before: QueueState,
+        after: QueueState,
+    },
+    Pending(Pending),
+}
+
+#[derive(Clone, Copy, Debug)]
+#[repr(u8)]
+pub enum Pending {
+    GoAway = 0,
+    Control = 1,
+    Decode = 2,
+    SendReady = 3,
+    SendFlush = 4,
+    Shutdown = 5,
+}
+
+#[derive(Clone, Copy, Debug)]
+#[repr(u8)]
+pub enum Origin {
+    HandleIo = 1,
+    HandleGoAway = 2,
+    ReceivedGoAway = 3,
+    CodecEof = 4,
+    DestructorEof = 5,
+    HandleOther = 6,
+}
+
+pub trait Observer: Send + Sync + std::fmt::Debug {
+    fn event(&self, event: Event);
+    fn runtime_flags(&self) -> Option<&std::sync::atomic::AtomicU64> {
+        None
+    }
+}
+
+pub(crate) fn runtime_begun(flags: Option<&std::sync::atomic::AtomicU64>) -> bool {
+    flags.map_or(false, |flags| {
+        flags.load(std::sync::atomic::Ordering::Acquire) & (1 << 21) != 0
+    })
+}
+
+// Scalar only: low two bits identify the initiator, upper bits are the reason.
+pub(crate) fn go_away(reason: crate::Reason, initiator: crate::proto::Initiator) -> u64 {
+    let initiator = match initiator {
+        crate::proto::Initiator::Library => 1,
+        crate::proto::Initiator::User => 2,
+        crate::proto::Initiator::Remote => 3,
+    };
+    (u64::from(u32::from(reason)) << 2) | initiator
+}
+
+pub(crate) fn terminal(result: &Result<(), crate::proto::Error>) {
+    use crate::proto::{Error, Initiator};
+    let (class, initiator, code) = match result {
+        Ok(()) => (1, 0, 0),
+        Err(Error::Io(kind, _)) => (2, 0, *kind as u32),
+        // poll2 consumes stream resets; they are not connection terminal results.
+        Err(Error::Reset(..)) => return,
+        Err(Error::GoAway(_, reason, initiator)) => {
+            let initiator = match initiator {
+                Initiator::Library => 1,
+                Initiator::User => 2,
+                Initiator::Remote => 3,
+            };
+            (3, initiator, u32::from(*reason))
+        }
+    };
+    emit(Event::Terminal {
+        class,
+        initiator,
+        code,
+    });
+}
+
+thread_local! {
+    static CURRENT: RefCell<Option<Arc<dyn Observer>>> = RefCell::new(None);
+}
+
+pub fn current() -> Option<Arc<dyn Observer>> {
+    CURRENT.with(|slot| slot.borrow().clone())
+}
+
+// Scope is synchronous (one construction/poll), never held across await.
+// Nested polls replace then restore context, including an explicit None.
+pub fn scope<T>(observer: Option<Arc<dyn Observer>>, poll: impl FnOnce() -> T) -> T {
+    struct Restore(Option<Arc<dyn Observer>>);
+    impl Drop for Restore {
+        fn drop(&mut self) {
+            CURRENT.with(|slot| slot.replace(self.0.take()));
+        }
+    }
+    let _restore = Restore(CURRENT.with(|slot| slot.replace(observer)));
+    poll()
+}
+
+pub(crate) fn emit(event: Event) {
+    if let Some(observer) = current() {
+        observer.event(event);
+    }
+}
+
+pub(crate) fn pending<T>(result: Poll<T>, stage: Pending) -> Poll<T> {
+    if result.is_pending() {
+        emit(Event::Pending(stage));
+    }
+    result
+}
