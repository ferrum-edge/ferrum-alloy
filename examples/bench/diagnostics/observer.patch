+    pub(super) fn diagnostic_spawn<F>(connection: F)
+    where
+        F: Future<Output = Result<(), hyper::Error>> + Send + 'static,
+    {
+        let control = HEALTH_WORKER
+            .try_with(|(diagnostics, index)| {
+                diagnostics.protocol_control.as_ref().and_then(|control| {
+                    (control.mode != ProtocolMode::Receive)
+                        .then(|| (Arc::clone(control), *index / 2))
+                })
+            })
+            .ok()
+            .flatten();
+        if let Some((control, index)) = control {
+            let mut dispatchers = control.dispatchers.lock().unwrap();
+            assert!(dispatchers[index].is_none());
+            dispatchers[index] = Some(Box::pin(connection));
+        } else {
+            tokio::spawn(connection);
+        }
+    }
