+    fn protocol_origin_pending(control: &ProtocolControl, diagnostics: &HealthDiagnostics) {
+        protocol_zero_errors(diagnostics);
+        assert!(control.public_held.load(Ordering::SeqCst));
+        {
+            let senders = control.senders.lock().unwrap();
+            // Keep the actual request channel open; a retained dispatcher alone
+            // does not own these sender handles.
+            for sender in senders.iter() {
+                assert!(sender.as_ref().is_some_and(|sender| !sender.is_closed()));
+            }
+        }
+        let (client, _) = protocol_pair(diagnostics);
+        let public = diagnostics
+            .observer
+            .socket_tasks("public-dispatcher", client.socket);
+        assert_eq!(public.len(), 1);
+        let public = public[0].snapshot();
+        assert!(public.pending > 0 && public.ready == 0 && !public.dropped);
+        let wires = diagnostics
+            .observer
+            .socket_tasks("h2-wire-child-pinned-first-spawn", client.socket);
+        assert_eq!(wires.len(), 1);
+        let wire = wires[0].snapshot();
+        assert!(wire.pending > 0 && wire.ready == 0 && !wire.dropped);
+        assert_eq!(client.protocol_snapshot().w[17], 0);
+        assert_eq!(client.protocol_snapshot().w[18], 0);
+        assert_eq!(client.protocol_snapshot().f & (1 << 21), 0);
+        assert!(control.dispatchers.lock().unwrap()[1].is_some());
+    }
+
+    fn protocol_origin_after_runtime_drop(
+        control: &ProtocolControl,
+        diagnostics: &HealthDiagnostics,
+    ) {
+        let (client, _) = protocol_pair(diagnostics);
+        let protocol = client.protocol_snapshot();
+        assert!(protocol.w[18] > 0);
+        assert!(protocol.w[17] > protocol.w[18]);
+        assert_eq!((protocol.f >> 17) & 7, 5);
+        assert_ne!(protocol.f & (1 << 20), 0);
+        assert_eq!(protocol.f & (1 << 23), 0);
+        assert_ne!(protocol.f & (1 << 21), 0);
+        assert_ne!(protocol.f & (1 << 22), 0);
+        assert_ne!(protocol.f & (1 << 28), 0);
+        assert_eq!((protocol.f >> 24) & 3, 0); // Wire child never returned Ready.
+        let wire = diagnostics
+            .observer
+            .socket_tasks("h2-wire-child-pinned-first-spawn", client.socket);
+        assert!(wire[0].snapshot().dropped);
+        assert_eq!(wire[0].snapshot().ready, 0);
+        let mut dispatcher = control.dispatchers.lock().unwrap()[1].take().unwrap();
+        let mut cx = Context::from_waker(std::task::Waker::noop());
+        let Poll::Ready(Err(error)) = dispatcher.as_mut().poll(&mut cx) else {
+            panic!("same retained Hyper dispatcher did not return the genuine drop error");
+        };
+        let mut source = std::error::Error::source(&error);
+        let mut broken_pipe = false;
+        while let Some(error) = source {
+            if let Some(error) = error.downcast_ref::<std::io::Error>() {
+                broken_pipe |= error.kind() == std::io::ErrorKind::BrokenPipe;
+            }
+            source = error.source();
+        }
+        assert!(broken_pipe);
+        diagnostics.worker(2, |state| {
+            assert_eq!(state.errors, 0);
+            assert_eq!(state.error_events, 1);
+            assert_eq!(state.wire_events, 0);
+            assert_eq!(
+                state
+                    .connection
+                    .as_ref()
+                    .unwrap()
+                    .driver
+                    .load(Ordering::Relaxed),
+                3,
+            );
+        });
+        assert_eq!(client.protocol_snapshot().w[17], protocol.w[17]);
+        assert_eq!(client.protocol_snapshot().w[18], protocol.w[18]);
+    }
