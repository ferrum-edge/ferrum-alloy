+    pub(super) fn protocol_tls_established<I>(stream: &tokio_rustls::client::TlsStream<I>) {
+        let _ = HEALTH_WORKER.try_with(|(diagnostics, _)| {
+            if diagnostics.protocol_control.is_some() {
+                assert_eq!(stream.get_ref().1.alpn_protocol(), Some(b"h2".as_slice()));
+                assert!(!stream.get_ref().1.peer_certificates().unwrap().is_empty());
+            }
+        });
+    }
