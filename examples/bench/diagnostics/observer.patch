+    fn protocol_origin_before_cleanup(control: &ProtocolControl, diagnostics: &HealthDiagnostics) {
+        protocol_zero_errors(diagnostics);
+        if control.mode != ProtocolMode::Teardown {
+            return;
+        }
+        protocol_origin_pending(control, diagnostics);
+    }
