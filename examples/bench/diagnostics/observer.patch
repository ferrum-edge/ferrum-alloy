+    async fn protocol_retained_health<F>(
+        mut health: Pin<&mut F>,
+        control: &ProtocolControl,
+        diagnostics: &HealthDiagnostics,
+        arrivals: &mut mpsc::UnboundedReceiver<Cancellation>,
+        held_snapshot: &mut Option<Box<HealthCapture>>,
+    ) -> Result<Measured<usize>, Failure>
+    where
+        F: Future<Output = Result<Measured<usize>, Failure>>,
+    {
+        use crate::health::Direction::{Rx, Tx};
+
+        if control.mode != ProtocolMode::Receive {
+            let measured = std::future::poll_fn(|cx| {
+                let result = health.as_mut().poll(cx);
+                if result.is_pending() {
+                    control.poll_dispatchers(cx, diagnostics);
+                }
+                result
+            })
+            .await?;
+            if control.mode == ProtocolMode::Alive {
+                protocol_origin_pending(control, diagnostics);
+                control.release_sender(2);
+                let dispatcher = control.dispatchers.lock().unwrap()[1].take().unwrap();
+                let result = dispatcher.await;
+                if result.is_err() {
+                    protocol_failure(diagnostics, "controlled-before-alive-error-unwind");
+                }
+                result.unwrap();
+                let (client, _) = protocol_pair(diagnostics);
+                let wires = diagnostics
+                    .observer
+                    .socket_tasks("h2-wire-child-pinned-first-spawn", client.socket);
+                while !wires[0].snapshot().dropped {
+                    tokio::task::yield_now().await;
+                }
+                assert_eq!(wires[0].snapshot().ready, 1);
+                assert_eq!((client.protocol_snapshot().f >> 24) & 3, 1);
+                assert!(client.snapshot().has_goaway(Tx, 0, 0));
+                protocol_zero_errors(diagnostics);
+            }
+            return Ok(measured);
+        }
+        let probes = tokio::select! {
+            result = health.as_mut() => {
+                return match result {
+                    Err(error) => Err(error),
+                    Ok(_) => panic!("receive control completed without the held prerequisites"),
+                };
+            }
+            probes = cancellations(arrivals, 4) => probes,
+        };
+        assert!(control.armed.load(Ordering::SeqCst));
+        let (client, server) = protocol_pair(diagnostics);
+        let next = loop {
+            let sent = client.snapshot().header_streams(Tx);
+            let received = client.snapshot().header_streams(Rx);
+            let next: Vec<_> = sent
+                .into_iter()
+                .filter(|id| !received.contains(id))
+                .collect();
+            let accepted = server.snapshot().header_streams(Tx);
+            let callbacks = diagnostics
+                .observer
+                .socket_tasks("h2-response-callback-child-empty-get", client.socket);
+            let pending = callbacks
+                .iter()
+                .filter(|task| {
+                    let state = task.snapshot();
+                    state.pending > 0 && state.ready == 0 && !state.dropped
+                })
+                .count();
+            if next.len() == 2 && next.iter().all(|id| accepted.contains(id)) && pending == 2 {
+                break next;
+            }
+            tokio::select! {
+                result = health.as_mut() => {
+                    return match result {
+                        Err(error) => Err(error),
+                        Ok(_) => panic!("held receive control lost its two pending callbacks"),
+                    };
+                }
+                _ = tokio::task::yield_now() => {}
+            }
+        };
+        let protocol = server.protocol_snapshot();
+        assert!(protocol.w[4] > 1);
+        assert!(protocol.w[16] > protocol.w[5]);
+        assert_ne!(protocol.n[3], protocol.n[1]);
+        assert_eq!(protocol.f & (1 << 16), 0);
+        let old = protocol.n[3];
+        let old_sent = server.snapshot().stream_data(old, Tx);
+        let old_received = client.snapshot().stream_data(old, Rx);
+        assert!(old_received.0 > 0 && old_received.1 > 0);
+        assert!(
+            old_sent.1 > old_received.1,
+            "required old DATA remainder is absent",
+        );
+        for id in &next {
+            assert!(server.snapshot().header_cursor(*id, Tx) > old_sent.2);
+            assert_eq!(client.snapshot().header_cursor(*id, Rx), 0);
+            assert_eq!(client.snapshot().stream_data(*id, Rx), (0, 0, 0));
+            assert!(server.snapshot().header_streams(Rx).contains(id));
+        }
+        let decoded = client.protocol_snapshot();
+        assert!(next.iter().all(|id| *id > decoded.n[0]));
+        let callbacks: Vec<_> = diagnostics
+            .observer
+            .socket_tasks("h2-response-callback-child-empty-get", client.socket)
+            .into_iter()
+            .filter(|task| {
+                let state = task.snapshot();
+                state.pending > 0 && state.ready == 0 && !state.dropped
+            })
+            .collect();
+        assert_eq!(callbacks.len(), 2);
+        let wakes: Vec<_> = callbacks.iter().map(|task| task.snapshot().wakes).collect();
+        for worker in 2..4 {
+            diagnostics.worker(worker, |state| {
+                assert_eq!(state.stage, "response-headers");
+                assert_eq!(state.exchanges[2].completed, 8);
+                assert_eq!(state.exchanges[3].completed, 0);
+                assert_eq!(state.exchanges[3].bytes, 0);
+            });
+        }
+        protocol_zero_errors(diagnostics);
+        let mut frozen = diagnostics.capture();
+        frozen.boundary = "controlled-held-client-plaintext-before-release";
+        let cell = crate::dims::Cell {
+            scenario: crate::dims::Scenario::Plain,
+            workload: Workload::Cancel,
+            transport: Transport::H2Mtls,
+        };
+        let before = diagnostics.render(cell, "controlled-before-runtime-cleanup", &frozen);
+        control.read.release();
+        drop(probes);
+        let measured = health.await?;
+        assert!(client.protocol_snapshot().w[13] > decoded.w[13]);
+        assert!(client.protocol_snapshot().w[14] > decoded.w[14]);
+        assert!(client.decoded_headers() >= decoded.headers() + 2);
+        for id in next {
+            assert!(client.snapshot().header_streams(Rx).contains(&id));
+            assert!(client.snapshot().stream_data(id, Rx).1 > 0);
+        }
+        for (callback, wakes) in callbacks.iter().zip(wakes) {
+            while !callback.snapshot().dropped {
+                tokio::task::yield_now().await;
+            }
+            let state = callback.snapshot();
+            assert!(state.wakes > wakes);
+            assert_eq!(state.ready, 1);
+        }
+        assert_eq!(diagnostics.coordinator.lock().unwrap().joined, 4);
+        for worker in 0..4 {
+            diagnostics.worker(worker, |state| {
+                assert_eq!(state.exchanges[3].completed, 1);
+                assert!(state.exchanges[3].bytes > 0);
+                assert_eq!(state.connection.as_ref().unwrap().generation, 1);
+            });
+        }
+        protocol_zero_errors(diagnostics);
+        assert_eq!(
+            before,
+            diagnostics.render(cell, "controlled-before-runtime-cleanup", &frozen),
+        );
+        // The original burst's real one-KiB payload contains this marker.
+        assert!(!before.contains("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"));
+        *held_snapshot = Some(frozen);
+        Ok(measured)
+    }
