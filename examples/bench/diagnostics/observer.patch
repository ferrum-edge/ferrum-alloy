+                            diagnostic_dial();
+                            let probe = DropProbe {
+                                diagnostics: Arc::clone(&diagnostics),
+                                dropped: Arc::clone(&future_drops),
+                                released: Arc::clone(&future_releases),
+                            };
+                            let driver = diagnostic_driver(async move {
+                                let _probe = probe;
+                                std::future::pending::<Result<(), hyper::Error>>().await
