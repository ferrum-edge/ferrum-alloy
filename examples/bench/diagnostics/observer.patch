+                panic!("protocol fixture requires its actual H2 sender");
+            };
+            let mut senders = self.senders.lock().unwrap();
+            assert!(senders[owner / 2].is_none());
+            senders[owner / 2] = Some(Sender::H2(sender.clone()));
+        }
