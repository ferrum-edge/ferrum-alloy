+    // Preserve the existing runtime destruction, including unwind paths. The
+    // wrapper adds only its endpoint entry mark before dropping that same runtime.
+    pub(crate) struct ProtocolRuntime {
+        runtime: Option<Runtime>,
+        diagnostics: Option<Arc<HealthDiagnostics>>,
+        server: bool,
+    }
+
+    impl ProtocolRuntime {
+        pub(crate) fn new(
+            runtime: Runtime,
+            diagnostics: Option<Arc<HealthDiagnostics>>,
+            server: bool,
+        ) -> Self {
+            Self {
+                runtime: Some(runtime),
+                diagnostics,
+                server,
+            }
+        }
+
+        fn mark_entry(&self) {
+            if let Some(diagnostics) = &self.diagnostics {
+                let endpoints = if self.server {
+                    diagnostics.observer.server_wires()
+                } else {
+                    diagnostics.observer.wires()
+                };
+                for wire in endpoints {
+                    wire.runtime_entry();
+                }
+            }
+        }
+
+        fn shutdown_timeout(mut self, duration: Duration) {
+            if let Some(runtime) = self.runtime.take() {
+                self.mark_entry();
+                runtime.shutdown_timeout(duration);
+            }
+        }
+    }
+
+    impl std::ops::Deref for ProtocolRuntime {
+        type Target = Runtime;
+
+        fn deref(&self) -> &Self::Target {
+            self.runtime.as_ref().unwrap()
+        }
+    }
+
+    impl Drop for ProtocolRuntime {
+        fn drop(&mut self) {
+            if let Some(runtime) = self.runtime.take() {
+                self.mark_entry();
+                drop(runtime);
+            }
+        }
+    }
