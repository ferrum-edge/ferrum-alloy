+    fn protocol_zero_errors(diagnostics: &HealthDiagnostics) {
+        // Keep the complete bounded endpoint/typed protocol state before any
+        // assertion unwind can destroy the retained dispatcher or runtimes.
+        let mut capture = diagnostics.capture();
+        capture.boundary = "controlled-before-zero-error-check";
+        let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            for worker in 0..4 {
+                diagnostics.worker(worker, |state| {
+                    assert_eq!(state.errors, 0);
+                    assert_eq!(state.error_events, 0);
+                    assert_eq!(state.wire_events, 0);
+                });
+            }
+            for wire in diagnostics
+                .observer
+                .wires()
+                .into_iter()
+                .chain(diagnostics.observer.server_wires())
+            {
+                assert!(wire.snapshot().protocol_error_free());
+                let protocol = wire.protocol_snapshot();
+                assert_eq!(protocol.f & (1 << 16), 0);
+                assert_ne!((protocol.f >> 24) & 3, 2);
+                if (protocol.f >> 24) & 3 == 3 {
+                    assert_eq!(protocol.f >> 32, 0);
+                }
+            }
+        }));
+        if let Err(error) = result {
+            diagnostics.failure_capture(
+                crate::dims::Cell {
+                    scenario: crate::dims::Scenario::Plain,
+                    workload: Workload::Cancel,
+                    transport: Transport::H2Mtls,
+                },
+                "controlled-zero-error-assertion",
+                &capture,
+            );
+            std::panic::resume_unwind(error);
+        }
+    }
+
+    fn protocol_failure(diagnostics: &HealthDiagnostics, boundary: &'static str) {
+        let mut capture = diagnostics.capture();
+        capture.boundary = boundary;
+        diagnostics.failure_capture(
+            crate::dims::Cell {
+                scenario: crate::dims::Scenario::Plain,
+                workload: Workload::Cancel,
+                transport: Transport::H2Mtls,
+            },
+            "controlled-protocol-error",
+            &capture,
+        );
+    }
