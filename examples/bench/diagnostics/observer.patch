+    fn protocol_pair(
+        diagnostics: &HealthDiagnostics,
+    ) -> (
+        Arc<crate::health::WireObservation>,
+        Arc<crate::health::WireObservation>,
+    ) {
+        let original = diagnostics.workers[2]
+            .lock()
+            .unwrap()
+            .connection
+            .as_ref()
+            .unwrap()
+            .local_addr
+            .unwrap();
+        let client = diagnostics
+            .observer
+            .wires()
+            .into_iter()
+            .find(|wire| wire.socket == Some(original))
+            .unwrap();
+        let server = diagnostics
+            .observer
+            .server_wires()
+            .into_iter()
+            .find(|wire| wire.remote == Some(original))
+            .unwrap();
+        assert_eq!((client.owner, client.generation), (2, 1));
+        assert_eq!(client.remote, server.socket);
+        assert_eq!(client.socket, server.remote);
+        (client, server)
+    }
