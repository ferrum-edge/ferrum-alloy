[package]
name = "{{name}}"
version = "0.1.0"
edition = "2024"
rust-version = "1.94"
publish = false

[dependencies]
{{alloy_dependency}}
axum = "0.8"
serde = { version = "1", features = ["derive"] }
tokio = { version = "1", features = ["macros", "rt-multi-thread"] }
{{extra_dependencies}}
[dev-dependencies]
http-body-util = "0.1"
serde_json = "1"
tower = { version = "0.5", features = ["util"] }
