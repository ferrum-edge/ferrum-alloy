//! Handler tests without a network listener.

use axum::body::Body;
use axum::http::{Request, StatusCode};
use http_body_util::BodyExt;
use tower::ServiceExt;

async fn call(request: Request<Body>) -> (StatusCode, serde_json::Value) {
    let response = {{crate_name}}::router().oneshot(request).await.expect("infallible");
    let status = response.status();
    let bytes = response.into_body().collect().await.expect("body").to_bytes();
    let json = serde_json::from_slice(&bytes).unwrap_or(serde_json::Value::Null);
    (status, json)
}

#[tokio::test]
async fn creates_items() {
    let (status, json) = call(
        Request::post("/items")
            .header("content-type", "application/json")
            .body(Body::from(r#"{"name":"tea","quantity":2}"#))
            .expect("request"),
    )
    .await;
    assert_eq!(status, StatusCode::CREATED);
    assert_eq!(json["name"], "tea");
}

#[tokio::test]
async fn invalid_items_are_problem_details() {
    let (status, json) = call(
        Request::post("/items")
            .header("content-type", "application/json")
            .body(Body::from(r#"{"name":"","quantity":0}"#))
            .expect("request"),
    )
    .await;
    assert_eq!(status, StatusCode::UNPROCESSABLE_ENTITY);
    assert_eq!(json["errors"].as_array().map(Vec::len), Some(2));
}

#[tokio::test]
async fn malformed_json_is_a_problem() {
    let (status, json) = call(
        Request::post("/items")
            .header("content-type", "application/json")
            .body(Body::from("{not json"))
            .expect("request"),
    )
    .await;
    assert_eq!(status, StatusCode::BAD_REQUEST);
    assert!(json["type"].as_str().unwrap_or_default().ends_with("malformed-json"));
}

#[tokio::test]
async fn unknown_items_use_the_application_problem_type() {
    let (status, json) = call(Request::get("/items/42").body(Body::empty()).expect("request")).await;
    assert_eq!(status, StatusCode::NOT_FOUND);
    assert_eq!(json["title"], "Item not found");
}
