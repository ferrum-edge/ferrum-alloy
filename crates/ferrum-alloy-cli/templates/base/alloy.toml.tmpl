# Ferrum Alloy configuration for {{name}}.
# Precedence: builder overrides > FERRUM_ALLOY_* environment > this file > defaults.
# Reference: https://github.com/ferrum-edge/ferrum-alloy/blob/main/docs/configuration.md

[service]
environment = "development"

[server]
# Loopback by default. In a container, bind explicitly, e.g.
# FERRUM_ALLOY_BIND=0.0.0.0:8080
bind = "127.0.0.1:8080"
request_body_limit_bytes = 1048576
request_timeout_ms = 30000

[management]
# Detailed health, metrics, and management OpenAPI/UI require a bearer token,
# even on loopback. Probes remain token-free. Supply a secret of 32+ characters
# through FERRUM_ALLOY_MANAGEMENT_TOKEN_FILE; protect that file from other users.
# Set the token before binding elsewhere. Never put a live token in this file.
bind = "127.0.0.1:9090"

[logging]
format = "compact"
{{alloy_starters}}
