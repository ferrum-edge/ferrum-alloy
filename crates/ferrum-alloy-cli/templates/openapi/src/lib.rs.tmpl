//! {{name}}: ordinary Axum handlers served by Ferrum Alloy, documented with
//! utoipa. Routes are registered once through `OpenApiRouter`, so the served
//! routes and the OpenAPI document cannot drift apart.

{{starter_modules}}use std::collections::BTreeMap;
use std::sync::{Arc, Mutex, PoisonError};

use axum::Router;
use axum::extract::State;
use axum::http::StatusCode;
use ferrum_alloy::agents::AgentTool;
use ferrum_alloy::extract::{Json, Path, ValidJson, Validate, ValidationErrors};
use ferrum_alloy::{Problem, ProblemKind};
use serde::{Deserialize, Serialize};
use utoipa::{OpenApi, ToSchema};
use utoipa_axum::router::OpenApiRouter;
use utoipa_axum::routes;

/// OpenAPI metadata (title and version default to the Cargo package).
/// Paths are added by `api()`.
#[derive(OpenApi)]
pub struct ApiDoc;

/// The most items the sample keeps; creating more is refused.
pub const MAX_ITEMS: usize = 1_000;

/// Application state, supplied with `Router::with_state`. Items live in
/// memory for the life of the process; replace the store with a database.
#[derive(Clone, Default)]
pub struct AppState {
    store: Arc<Mutex<Store>>,
}

#[derive(Default)]
struct Store {
    next_id: u64,
    items: BTreeMap<u64, Item>,
}

/// A request to create an item.
#[derive(Debug, Deserialize, ToSchema)]
pub struct NewItem {
    /// Item name.
    pub name: String,
    /// Quantity (at least 1).
    pub quantity: u32,
}

impl Validate for NewItem {
    fn validate(&self) -> Result<(), ValidationErrors> {
        let mut errors = ValidationErrors::default();
        if self.name.trim().is_empty() {
            errors.add("/name", "must not be empty");
        }
        if self.quantity == 0 {
            errors.add("/quantity", "must be at least 1");
        }
        errors.into_result()
    }
}

/// A created item.
#[derive(Debug, Clone, Serialize, ToSchema)]
pub struct Item {
    /// Identifier.
    pub id: u64,
    /// Item name.
    pub name: String,
    /// Quantity.
    pub quantity: u32,
}

/// Greeting.
#[utoipa::path(get, path = "/hello", responses((status = 200, description = "Greeting", body = String)))]
async fn hello() -> &'static str {
    "Hello from {{name}}"
}

/// Create an item.
#[utoipa::path(
    post,
    path = "/items",
    request_body = NewItem,
    responses(
        (status = 201, description = "Created", body = Item),
        (status = 422, description = "Invalid item (application/problem+json)"),
        (status = 507, description = "The sample's item store is full (application/problem+json)")
    )
)]
async fn create_item(
    State(state): State<AppState>,
    ValidJson(item): ValidJson<NewItem>,
) -> Result<(StatusCode, Json<Item>), Problem> {
    let mut store = state.store.lock().unwrap_or_else(PoisonError::into_inner);
    if store.items.len() >= MAX_ITEMS {
        return Err(Problem::custom(
            "tag:example.com,2026:{{name}}/problem/item-store-full",
            "Item store full",
            StatusCode::INSUFFICIENT_STORAGE,
        )
        .with_detail(format!("the sample keeps at most {MAX_ITEMS} items")));
    }
    store.next_id += 1;
    let item = Item {
        id: store.next_id,
        name: item.name,
        quantity: item.quantity,
    };
    store.items.insert(item.id, item.clone());
    Ok((StatusCode::CREATED, Json(item)))
}

/// Fetch an item.
///
/// Offered to AI agents as a read-only MCP tool: `AgentTool::expose()` writes
/// this operation's `x-ferrum-mcp` extension, and `[agents]` in
/// ferrum-service.toml publishes it through Ferrum Edge. Expose only what an
/// agent may do on a user's behalf; a state-changing operation needs its own
/// explicit `AgentTool::expose()`.
#[utoipa::path(
    get,
    path = "/items/{id}",
    params(("id" = u64, Path, description = "Item identifier")),
    responses(
        (status = 200, description = "The item", body = Item),
        (status = 404, description = "Not found (application/problem+json)"),
        (status = 422, description = "The identifier is zero (application/problem+json)")
    ),
    extensions(("x-ferrum-mcp" = json!(AgentTool::expose()
        .description("Fetch one item by its numeric identifier"))))
)]
async fn get_item(
    State(state): State<AppState>,
    Path(id): Path<u64>,
) -> Result<Json<Item>, Problem> {
    if id == 0 {
        return Err(Problem::new(ProblemKind::ValidationFailed).with_detail("id must be positive"));
    }
    let store = state.store.lock().unwrap_or_else(PoisonError::into_inner);
    match store.items.get(&id) {
        Some(item) => Ok(Json(item.clone())),
        None => Err(Problem::custom(
            "tag:example.com,2026:{{name}}/problem/item-not-found",
            "Item not found",
            StatusCode::NOT_FOUND,
        )
        .with_detail(format!("no item with id {id}"))),
    }
}

/// The router and its OpenAPI document, from one registration.
pub fn api() -> (Router, utoipa::openapi::OpenApi) {
    let (router, document) = OpenApiRouter::with_openapi(ApiDoc::openapi())
        .routes(routes!(hello))
        .routes(routes!(create_item))
        .routes(routes!(get_item))
        .split_for_parts();
    (router.with_state(AppState::default()), document)
}

/// The application router.
pub fn router() -> Router {
    api().0
}

/// The OpenAPI document.
pub fn openapi() -> utoipa::openapi::OpenApi {
    api().1
}
