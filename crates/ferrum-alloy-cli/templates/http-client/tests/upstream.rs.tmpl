//! The outbound client configured from alloy.toml, against a local server.

use std::path::Path;

use axum::Extension;
use axum::Router;
use axum::body::Body;
use axum::http::{HeaderMap, Request, StatusCode};
use axum::routing::get;
use ferrum_alloy::config::{HttpClientSettings, Overrides, load_from};
use ferrum_alloy::http_client::AlloyClient;
use ferrum_alloy::telemetry::PeerTrust;
use ferrum_alloy::telemetry::context::{RequestContext, TraceDecision};
use ferrum_alloy::telemetry::request_id::{RequestId, RequestIdSource};
use ferrum_alloy::telemetry::trace_context::{SpanId, TraceId};
use http_body_util::BodyExt;
use serde_json::Value;
use tokio::net::TcpListener;
use tower::ServiceExt;
use url::Url;

use {{crate_name}}::upstream::{self, Upstream};

/// Headers an upstream outside the propagation allow-list must never see.
const SENSITIVE: &[&str] = &["traceparent", "baggage", "authorization", "cookie"];

/// `[http_client]` from alloy.toml, without environment overrides.
fn configured() -> HttpClientSettings {
    let file = Path::new(concat!(env!("CARGO_MANIFEST_DIR"), "/alloy.toml"));
    let loaded = load_from(Some(file), std::iter::empty(), &Overrides::default());
    let (config, _) = loaded.expect("alloy.toml loads");
    config.http_client
}

/// Lists the sensitive headers the upstream received.
async fn echo(headers: HeaderMap) -> String {
    SENSITIVE
        .iter()
        .filter(|name| headers.contains_key(**name))
        .copied()
        .collect::<Vec<_>>()
        .join(",")
}

/// Serves `echo` on loopback and returns its URL.
async fn local_upstream() -> Url {
    let listener = TcpListener::bind("127.0.0.1:0").await.expect("bind");
    let addr = listener.local_addr().expect("address");
    let app = Router::new().route("/echo", get(echo));
    tokio::spawn(async move { axum::serve(listener, app).await });
    let url = format!("http://{addr}/echo");
    upstream::parse_url(&url).expect("url")
}

/// A request context like the one the telemetry layer inserts in service.
fn context() -> RequestContext {
    RequestContext {
        request_id: RequestId::generate(),
        request_id_source: RequestIdSource::Generated,
        trace_id: TraceId([0x11; 16]),
        span_id: SpanId([0x22; 8]),
        sampled: true,
        exported: false,
        trace_decision: TraceDecision::Root,
        remote_parent: None,
        tracestate: None,
        peer_trust: PeerTrust::Untrusted,
        span: tracing::Span::none(),
    }
}

/// Calls `GET /upstream` with a request context, so that trace context
/// propagation runs.
async fn call(target: Upstream) -> (StatusCode, Value) {
    let request = Request::get("/upstream").body(Body::empty());
    let response = upstream::router(target)
        .layer(Extension(context()))
        .oneshot(request.expect("request"))
        .await
        .expect("infallible");
    let status = response.status();
    let body = response.into_body().collect().await.expect("body");
    let json = serde_json::from_slice(&body.to_bytes()).unwrap_or(Value::Null);
    (status, json)
}

#[test]
fn alloy_toml_sets_timeouts_and_propagates_nothing() {
    let settings = configured();
    assert!(settings.connect_timeout_ms > 0);
    assert!(settings.request_timeout_ms > 0);
    assert_eq!(settings.max_redirects, 0);
    assert!(settings.propagate_trace_context_to.is_empty());
}

#[test]
fn upstream_urls_are_http_without_credentials() {
    assert!(upstream::parse_url(upstream::DEFAULT_URL).is_ok());
    assert!(upstream::parse_url("https://api.example.com/v1").is_ok());
    for invalid in [
        "",
        "not a url",
        "/relative/path",
        "ftp://example.com/file",
        "https://user@example.com/",
        "https://user:secret@example.com/",
    ] {
        assert!(upstream::parse_url(invalid).is_err(), "{invalid:?}");
    }
    let result = upstream::parse_url("https://user:secret@example.com/");
    let error = result.expect_err("credentials are rejected");
    assert!(!error.contains("secret"), "{error}");
}

#[tokio::test]
async fn calls_the_upstream_without_sensitive_headers() {
    let client = AlloyClient::new(&configured()).expect("client");
    let (status, json) = call(Upstream::new(client, local_upstream().await)).await;
    assert_eq!(status, StatusCode::OK, "{json}");
    assert_eq!(json["status"], 200);
    assert_eq!(json["body"], "", "sensitive headers reached the upstream");
}

/// The positive control for the test above: with the upstream's host on the
/// allow-list, the same call does carry `traceparent`.
#[tokio::test]
async fn an_allow_listed_upstream_receives_only_traceparent() {
    let mut settings = configured();
    settings.propagate_trace_context_to = vec!["127.0.0.1".into()];
    let client = AlloyClient::new(&settings).expect("client");
    let (status, json) = call(Upstream::new(client, local_upstream().await)).await;
    assert_eq!(status, StatusCode::OK, "{json}");
    assert_eq!(json["body"], "traceparent");
}

#[tokio::test]
async fn an_unreachable_upstream_is_a_bad_gateway_problem() {
    let client = AlloyClient::new(&configured()).expect("client");
    // Nothing listens on port 1 of the loopback interface.
    let url = upstream::parse_url("http://127.0.0.1:1/").expect("url");
    let (status, json) = call(Upstream::new(client, url)).await;
    assert_eq!(status, StatusCode::BAD_GATEWAY);
    assert_eq!(json["title"], "Upstream request failed");
}
