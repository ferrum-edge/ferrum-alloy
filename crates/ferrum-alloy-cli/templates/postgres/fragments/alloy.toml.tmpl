
[database]
# Local development only. Elsewhere, set FERRUM_ALLOY_DATABASE_URL (or
# FERRUM_ALLOY_DATABASE_URL_FILE) instead of committing credentials.
url = "postgres://postgres:postgres@127.0.0.1:5432/postgres"
max_connections = 10
acquire_timeout_ms = 5000
# Migrations are a separate step (`cargo run -- migrate`). Setting this to
# true applies them at every start, from every replica: development only.
migrate_on_startup = false
# A cached `SELECT 1` behind /readyz.
readiness_check = true
