# Snapshots, fixtures, and templates are compared byte for byte, and
# generated files use LF on every platform. Keep LF in every checkout.
* text=auto eol=lf
# Vendored third-party files are checked byte for byte against their
# published hashes (SHA256SUMS). Never convert them; minified files have no
# useful line diff.
crates/ferrum-alloy/assets/** -text
crates/ferrum-alloy/assets/**/*.js -diff linguist-vendored
crates/ferrum-alloy/assets/**/*.css -diff linguist-vendored
# Pinned Ferrum contracts are checked byte for byte against the hashes in
# contracts/ferrum-contracts/PIN. Never convert them.
contracts/ferrum-contracts/** -text
