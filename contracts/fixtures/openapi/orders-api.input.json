{
  "components": {
    "schemas": {
      "NewOrder": {
        "properties": {
          "item": {
            "description": "Item name (1-200 characters).",
            "type": "string"
          },
          "quantity": {
            "description": "Quantity (positive).",
            "format": "int32",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "item",
          "quantity"
        ],
        "type": "object"
      },
      "Order": {
        "properties": {
          "id": {
            "format": "int64",
            "minimum": 0,
            "type": "integer"
          },
          "item": {
            "type": "string"
          },
          "quantity": {
            "format": "int32",
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "item",
          "quantity"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Orders service built with Ferrum Alloy",
    "title": "orders-api",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/orders": {
      "get": {
        "description": "Newest first, at most `limit` orders.",
        "operationId": "list_orders",
        "parameters": [
          {
            "description": "Most orders to return (1-100).",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Orders"
          }
        },
        "summary": "List orders.",
        "x-ferrum-mcp": {
          "description": "List the caller's orders, newest first",
          "expose": true
        }
      },
      "post": {
        "operationId": "create_order",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewOrder"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            },
            "description": "Created"
          },
          "422": {
            "description": "Invalid order (application/problem+json)"
          }
        },
        "summary": "Place an order.",
        "x-ferrum-mcp": {
          "annotations": {
            "destructiveHint": false
          },
          "description": "Place a new order for the caller",
          "expose": true
        }
      }
    },
    "/orders/{id}": {
      "delete": {
        "operationId": "cancel_order",
        "parameters": [
          {
            "description": "Order identifier",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Cancelled"
          },
          "404": {
            "description": "Not found (application/problem+json)"
          }
        },
        "summary": "Cancel an order."
      },
      "get": {
        "operationId": "get_order",
        "parameters": [
          {
            "description": "Order identifier",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            },
            "description": "The order"
          },
          "404": {
            "description": "Not found (application/problem+json)"
          }
        },
        "summary": "Fetch an order.",
        "x-ferrum-mcp": {
          "description": "Fetch one of the caller's orders by its identifier",
          "expose": true
        }
      }
    },
    "/orders/{id}/receipt": {
      "get": {
        "operationId": "get_receipt",
        "parameters": [
          {
            "description": "Order identifier",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/pdf": {}
            },
            "description": "PDF receipt"
          }
        },
        "summary": "Download the receipt.",
        "x-ferrum-mcp": {
          "expose": false
        }
      }
    },
    "/orders/{id}/status": {
      "get": {
        "operationId": "get_order_status",
        "parameters": [
          {
            "description": "Order identifier",
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "int64",
              "minimum": 0,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "state": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "state"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Status"
          }
        },
        "summary": "Order fulfilment status."
      }
    }
  }
}
